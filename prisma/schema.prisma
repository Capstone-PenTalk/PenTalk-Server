generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ACTIVE
  CLOSING
  ARCHIVED
  FAILED
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

model User {
  id           String        @id @default(cuid())
  loginId      String?       @unique
  passwordHash String?
  provider     String        @default("local") // "local" | "google" | "kakao"
  providerId   String?
  email        String?       @unique
  name         String?
  role         String?       // 소셜 로그인 최초 가입 시 역할 선택 전에는 null
  studentNumber String?      // 학생 전용 전역 프로필 필드. teacher는 사용하지 않음(항상 null)
  createdAt    DateTime      @default(now())
  classes      Class[]       @relation("TeacherClasses")
  ClassMember  ClassMember[]

  @@unique([provider, providerId])
}

model Class {
  id          String        @id @default(cuid())
  title       String
  createdAt   DateTime      @default(now())
  teacherId   String
  teacher     User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  ClassMember ClassMember[]
  materials   Material[]
  sessions    Session[]
}

model Material {
  id              String            @id @default(cuid())
  type            String
  url             String
  name            String?           // ✅ #93: 원본 파일명. nullable인 이유: 기존 데이터(외부 URL 등록분)와의 호환. 신규 업로드분은 항상 채워짐.
  createdAt       DateTime          @default(now())
  classId         String
  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  MaterialSubject MaterialSubject[]
  MaterialTag     MaterialTag[]
  sessions        Session[]
  MaterialPage    MaterialPage[]

  @@index([classId, createdAt])
}

// 교사/학생 기기별 PDF 렌더러 차이(PDFKit vs PdfRenderer)로 판서 좌표가 어긋나는 문제 해결을 위해
// 업로드 시점에 서버가 페이지별 PNG로 래스터화해서 저장. 모든 클라이언트가 동일 이미지+치수 기준으로 렌더링.
model MaterialPage {
  id         String   @id @default(cuid())
  materialId String
  pageNumber Int
  imageKey   String   // S3 객체 키 (Material.url과 동일 관례, presigned URL은 조회 시점에 생성)
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  Material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, pageNumber])
  @@index([materialId])
}

model ClassMember {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  roleInClass String   @default("student")
  userId      String
  classId     String
  Class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
}

model MaterialSubject {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  materialId String
  subjectId  String
  Material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  Subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([materialId, subjectId])
  @@index([subjectId, materialId])
}

model MaterialTag {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  materialId String
  tagId      String
  Material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  Tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([materialId, tagId])
  @@index([tagId, materialId])
}

model Subject {
  id              String            @id @default(cuid())
  name            String            @unique
  createdAt       DateTime          @default(now())
  MaterialSubject MaterialSubject[]
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  createdAt   DateTime      @default(now())
  MaterialTag MaterialTag[]
}

model Session {
  id            String          @id @default(cuid())
  classId       String
  class         Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  status        SessionStatus   @default(ACTIVE)
  title         String?         // #124
  capacity      Int?            // #124
  passwordHash  String?         // #124
  drawingPath   String?
  closedAt      DateTime?
  endAttempts   Int             @default(0)
  endError      String?
  createdAt     DateTime        @default(now())
  quizQuestions QuizQuestion[]  // ✅ #60

  @@index([classId, createdAt])
  @@index([status])
}

model QuizQuestion {
  id        String        @id @default(cuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int           // 1, 2, 3
  createdAt DateTime      @default(now())
  answers   QuizAnswer[]  // ✅ #62

  @@unique([sessionId, order])
  @@index([sessionId])
}

model QuizAnswer {
  id              String      @id @default(cuid())
  sessionId       String
  questionId      String
  question        QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId          String
  submittedAnswer String
  isCorrect       Boolean
  createdAt       DateTime    @default(now())

  @@unique([sessionId, questionId, userId])
  @@index([sessionId, questionId])
}

model Question {
  id          String         @id @default(cuid())
  sessionId   String
  userId      String
  content     String
  status      QuestionStatus @default(PENDING)
  isAnonymous Boolean        @default(false)
  answer      String?
  answeredAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([sessionId, createdAt])
}
